{
  "manifest_version": 3,
  "name": "ChatGPT 对话目录",
  "version": "1.0.0",
  "description": "右侧提问目录、阅读位置高亮与长对话跳转。全部处理在浏览器本地完成。",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
